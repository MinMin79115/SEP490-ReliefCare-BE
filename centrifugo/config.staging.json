{
  "log": {
    "level": "info"
  },
  "client": {
    "allowed_origins": [
      "https://staging.reliefhub.info.vn",
      "https://reliefhub.info.vn",
      "https://relief-carevn.vercel.app",
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200"
    ],
    "token": {
      "hmac_secret_key": "__CENTRIFUGO_SECRET__",
      "issuer": "ReliefCare.API",
      "audience": "ReliefCare.Realtime"
    }
  },
  "http_api": {
    "key": "__CENTRIFUGO_API_KEY__",
    "error_mode": "transport"
  },
  "health": {
    "enabled": true
  },
  "admin": {
    "enabled": false
  },
  "prometheus": {
    "enabled": false
  },
  "presence": true,
  "history_size": 50,
  "history_ttl": "30m"
}
